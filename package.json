{
  "name": "myregulars",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,pb -c blue,green \"npm:dev:web\" \"npm:dev:pb\"",
    "dev:web": "next dev",
    "dev:pb": "bash scripts/pocketbase.sh",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright install chromium && playwright test --pass-with-no-tests --reporter=list",
    "validate": "npm run format:check && npm run typecheck && npm run lint && npm test",
    "format-and-validate": "npm run format && npm run validate"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.15.0",
    "lucide-react": "^0.510.0",
    "next": "16.2.4",
    "pocketbase": "^0.27.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "get-port": "^7.2.0",
    "happy-dom": "^20.9.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.0.0-insiders.f7d2598",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
