{
  "name": "myregulars",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,pb -c blue,green \"npm:dev:web\" \"npm:dev:pb\"",
    "dev:web": "next dev",
    "dev:pb": "bash scripts/pocketbase.sh",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright install chromium webkit && playwright test --pass-with-no-tests --reporter=list",
    "test:e2e:dev": "PLAYWRIGHT_DEV=1 npm run test:e2e",
    "validate": "npm run format:check && npm run typecheck && npm run lint && npm test",
    "format-and-validate": "npm run format && npm run validate",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types",
    "pb:deploy": "scripts/phio.sh deploy",
    "pb:dev": "scripts/phio.sh dev"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "pocketbase": "^0.27.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "get-port": "^7.2.0",
    "happy-dom": "^20.9.0",
    "phio": "^0.4.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5",
    "wrangler": "^4.156.2"
  }
}
