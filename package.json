{
  "name": "myregulars",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright install chromium && playwright test --pass-with-no-tests --reporter=list",
    "validate": "npm run format:check && npm run typecheck && npm run lint && npm test",
    "format-and-validate": "npm run format && npm run validate"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "get-port": "^7.2.0",
    "happy-dom": "^20.9.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.0.0-insiders.f7d2598",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
