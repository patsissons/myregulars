# GitHub Gists vault provider (OAuth app with the `gist` scope).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Hosted (PocketBase) vault provider.
# Local dev default is the instance started by `npm run pb:dev`.
# In production, point this at your PocketHost instance URL.
# NOTE: social-login OAuth2 client IDs/secrets are configured INSIDE
# PocketBase (Admin UI -> users collection -> OAuth2), not here. This URL is
# public (NEXT_PUBLIC_) because the browser talks to PocketBase directly.
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
