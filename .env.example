# Copy the secret values into .env.local (gitignored). The non-secret values
# already live in the committed .env; override them there or here as needed.

# ── Secrets → .env.local ─────────────────────────────────────────────────────

# GitHub Gists vault provider (OAuth app with the `gist` scope).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Local PocketBase superuser password. The launcher (scripts/pocketbase.sh)
# creates/updates this superuser on startup using PB_SUPERUSER_EMAIL (.env).
PB_SUPERUSER_PASSWORD=

# Hosted social-login OAuth2 secrets. Set the pairs you want enabled; on
# startup the launcher configures these providers on the PocketBase `users`
# collection. Leave a pair blank to skip that provider. These are SEPARATE
# from the gist GITHUB_OAUTH_* credentials above.
PB_OAUTH2_GITHUB_CLIENT_ID=
PB_OAUTH2_GITHUB_CLIENT_SECRET=
PB_OAUTH2_GOOGLE_CLIENT_ID=
PB_OAUTH2_GOOGLE_CLIENT_SECRET=
PB_OAUTH2_APPLE_CLIENT_ID=
PB_OAUTH2_APPLE_CLIENT_SECRET=
PB_OAUTH2_FACEBOOK_CLIENT_ID=
PB_OAUTH2_FACEBOOK_CLIENT_SECRET=
PB_OAUTH2_TWITTER_CLIENT_ID=
PB_OAUTH2_TWITTER_CLIENT_SECRET=

# ── Non-secret → .env (committed) ────────────────────────────────────────────
# NEXT_PUBLIC_POCKETBASE_URL  PocketBase base URL the browser connects to.
# PB_HOST / PB_PORT           Local PocketBase bind address.
# PB_VERSION                  Pin a PocketBase release (blank = latest).
# PB_SUPERUSER_EMAIL          Local dev superuser email.
