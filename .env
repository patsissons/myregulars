# Public, non-secret configuration — safe to commit.
# Secrets (OAuth client secrets, the PocketBase superuser password) live in
# .env.local, which is gitignored. See .env.example for the full list.

# Hosted (PocketBase) vault provider. The browser talks to PocketBase directly,
# so this is a NEXT_PUBLIC_ var. The default targets the local instance started
# by `npm run dev:pb`. In production, override with your PocketHost URL.
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Local PocketBase launcher settings (consumed by scripts/pocketbase.sh).
PB_HOST=127.0.0.1
PB_PORT=8090
# Pin a PocketBase version, or leave blank to use the latest release.
PB_VERSION=

# Local dev superuser email (its password belongs in .env.local).
PB_SUPERUSER_EMAIL=admin@example.com
